{
  "name": "@kyizl/craftify",
  "version": "1.3.0",
  "description": "Typed, runtime-validated API wrapper for PikaNetwork.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kyizl/craftify.git"
  },
  "license": "MIT",
  "author": "kyizl",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "unbuild",
    "check": "knip && publint && attw --pack .",
    "commit": "cz",
    "coverage": "vitest run --coverage",
    "dev": "unbuild --stub",
    "docs:api": "typedoc",
    "docs:build": "npm run docs:openapi && npm run docs:api && vitepress build docs",
    "docs:deploy": "npm run docs:build && wrangler deploy",
    "docs:dev": "npm run docs:openapi && npm run docs:api && vitepress dev docs",
    "docs:openapi": "node scripts/generate-pika-openapi-docs.mjs",
    "docs:openapi:update": "node scripts/update-pika-openapi.mjs && npm run docs:openapi",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:md": "markdownlint-cli2 \"**/*.md\"",
    "lint:md:fix": "markdownlint-cli2 --fix \"**/*.md\"",
    "prepare": "husky",
    "release": "semantic-release",
    "stage": "npm run lint:fix && npm run format && npm run lint:md:fix && npm run verify",
    "test": "vitest run",
    "test:types": "tsd",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "overrides": {
    "unbuild": {
      "typescript": "$typescript"
    }
  },
  "dependencies": {
    "consola": "^3.4.2",
    "defu": "^6.1.7",
    "keyv": "^5.6.0",
    "ofetch": "^1.5.1",
    "p-queue": "^8.1.1",
    "p-retry": "^8.0.0",
    "ts-pattern": "^5.9.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^4.1.11",
    "commitizen": "^4.3.2",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-unicorn": "^73.0.0",
    "husky": "^9.1.7",
    "knip": "^6.32.2",
    "lint-staged": "^17.3.0",
    "markdownlint-cli2": "^0.23.2",
    "prettier": "^3.9.6",
    "prettier-plugin-packagejson": "^3.0.2",
    "publint": "^0.3.24",
    "semantic-release": "^25.0.9",
    "tsd": "^0.33.0",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.12.0",
    "typedoc-vitepress-theme": "^1.1.3",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.67.0",
    "unbuild": "^3.6.1",
    "vitepress": "^1.6.4",
    "vitest": "^4.1.11",
    "vue": "^3.5.44",
    "wrangler": "^4.24.4"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.25.12": true,
    "esbuild@0.21.5": true,
    "esbuild@0.28.1": true,
    "unrs-resolver@1.12.2": true,
    "workerd@1.20260820.1": true
  }
}
